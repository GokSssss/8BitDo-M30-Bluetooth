+import app.m30.companion.BluetoothDiscoveryMatches;
+public final class BluetoothDiscoveryMatchesTest {
+    private static void check(boolean ok,String message){if(!ok)throw new AssertionError(message);}
+    public static void main(String[] args){
+        BluetoothDiscoveryMatches m=new BluetoothDiscoveryMatches();
+        String a="11:22:33:EA:EB:39",b="11:22:33:22:2C:39",sameSuffix="99:88:77:EA:EB:39";
+        m.saved(a,true);m.saved(b,true);
+        check(m.count()==0&&!m.isFound(a),"Cached bonds must never count as radio discovery");
+        check(m.summary(false).contains("ещё не проверены"),"No scan evidence at launch/start failure");
+        m.started();check(m.row(a,false).contains("не обнаружен"),"Saved-only row is explicit");
+        m.discovered("11:22:33:ea:eb:39");
+        check(m.matches(a)&&m.count()==1&&!m.matches(b),"Only exact full address matches; two same-named controllers stay separate");
+        m.discovered(a);check(m.count()==1,"Duplicate broadcasts do not inflate matches");
+        m.discovered(sameSuffix);check(!m.matches(sameSuffix)&&m.count()==1,"Short suffix collision is not identity");
+        check(m.row(a,false).contains("совпадает")&&m.summary(true).contains("1"),"Positive match is visible independently of scan status");
+        check(m.row(sameSuffix,false).contains("новая пара"),"Unpaired discovery stays distinct");
+        m.saved(a,false);check(m.count()==0&&m.isFound(a),"Removed bond is no longer a saved match");
+        m.saved(sameSuffix,true);check(m.count()==1,"Newly saved discovered pair updates matching");
+        m.forget(sameSuffix);check(m.count()==0,"Excluded candidates do not enter summary");
+        m.reset();check(!m.isFound(a)&&!m.isSaved(b)&&m.count()==0,"Each new scan clears stale evidence");
+        m.saved(a,true);m.started();check(m.summary(false).contains("не обнаружено"),"Completed scan with no matching evidence");
+        m.discovered("EA:EB:39");m.saved("EA:EB:39",true);check(m.count()==0,"Invalid/truncated address ignored");
+        check(m.row(a,true).contains("Сопряжение")||m.row(a,true).contains("сопряжение"),"Bonding is still separate");
+        System.out.println("PASS: cached bond versus actual discovery, full-address identity, duplicates, suffix collisions, fresh scans, filtered/removed/new bonds and explicit summaries");
+    }
+}
