+++ 1.36/app/src/main/java/app/m30/companion/BluetoothDiscoveryMatches.java
@@ -0,0 +1,34 @@
+package app.m30.companion;
+
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+
+/** A saved bond is not discovery evidence. Match full addresses within one explicit scan. */
+public final class BluetoothDiscoveryMatches {
+    private final Set<String> saved=new HashSet<>(),found=new HashSet<>();
+    private boolean started;
+    private static String key(String address){return address!=null&&address.matches("(?i)([0-9a-f]{2}:){5}[0-9a-f]{2}")?address.toUpperCase(Locale.ROOT):null;}
+    public void reset(){saved.clear();found.clear();started=false;}
+    public void started(){started=true;}
+    public void saved(String address,boolean value){String key=key(address);if(key==null)return;if(value)saved.add(key);else saved.remove(key);}
+    public void discovered(String address){String key=key(address);if(key!=null)found.add(key);}
+    public void forget(String address){String key=key(address);saved.remove(key);found.remove(key);}
+    public boolean isSaved(String address){return saved.contains(key(address));}
+    public boolean isFound(String address){return found.contains(key(address));}
+    public boolean matches(String address){return isSaved(address)&&isFound(address);}
+    public int count(){int count=0;for(String address:found)if(saved.contains(address))count++;return count;}
+    public String row(String address,boolean bonding){
+        if(bonding)return isFound(address)?"Обнаружен в этом поиске · сопряжение…":"Сопряжение…";
+        if(matches(address))return "Найден рядом · совпадает с сохранённой парой";
+        if(isSaved(address))return "Сохранённая пара · в этом поиске не обнаружен";
+        return isFound(address)?"Найден рядом · новая пара":"Новая пара";
+    }
+    public String summary(boolean searching){
+        int matches=count();
+        if(matches>0)return "Найдено совпадений с сохранёнными парами: "+matches+". Геймпад обнаружен в этом поиске; подключение проверяется отдельно.";
+        if(!started)return "Сохранённые пары ещё не проверены поиском.";
+        if(searching)return "Ищем совпадения с сохранёнными парами…";
+        return "Совпадений с сохранёнными парами в этом поиске не обнаружено. Наличие пары не подтверждает, что геймпад сейчас рядом.";
+    }
+}
