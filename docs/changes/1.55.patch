+                @Override public void onFailure(CharSequence error){if(!isFinishing()&&!isDestroyed())failure("Android не подтвердил доступ к выбранному джойстику. Включите его и повторите. Метка приложения сохранена.");}
+            },handler);
+        }catch(RuntimeException error){failure("На этом устройстве Android не разрешил доступ для переименования. Метка приложения сохранена.");}
+    }
+    @Override protected void onActivityResult(int request,int result,Intent data){super.onActivityResult(request,result,data);if(request!=CONFIRM||finished)return;awaiting=false;handler.removeCallbacks(timeout);
