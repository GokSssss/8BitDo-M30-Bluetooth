+        try{
+            int result=device.setAlias(alias);
+            String actual=device.getAlias();
+            if(result==BluetoothStatusCodes.SUCCESS&&alias.equals(actual)){finished=true;Toast.makeText(this,"Имя в Bluetooth: "+actual,Toast.LENGTH_LONG).show();setResult(RESULT_OK);finish();}
