+        }catch(RuntimeException error){failure("Android не разрешил изменение имени. Метка приложения сохранена.");}
+    }
+    @SuppressWarnings("deprecation") private boolean associated(){for(String value:manager.getAssociations())if(address.equalsIgnoreCase(value))return true;return false;}
+    @SuppressWarnings("deprecation") private void associate(){
